  redis:
    image: redis:7-alpine
    container_name: {{.ProjectName}}-redis
    restart: unless-stopped
    ports:
      - "{{.Database.Port}}:6379"
    environment:
      REDIS_PASSWORD: {{.Database.Environment.REDIS_PASSWORD}}
    volumes:
      - {{.Database.Volume}}:/data
      - ./redis-config/redis.conf:/usr/local/etc/redis/redis.conf:ro
    networks:
      - {{.ProjectName}}-network
    healthcheck:
      test: ["CMD", "redis-cli", "--raw", "incr", "ping"]
      interval: 30s
      timeout: 10s
      retries: 3
    command: redis-server /usr/local/etc/redis/redis.conf --requirepass {{.Database.Environment.REDIS_PASSWORD}}