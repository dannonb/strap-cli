.App {
  text-align: center;
}

.App-header {
  background-color: #282c34;
  padding: 20px;
  color: white;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: calc(10px + 2vmin);
}

.App-header h1 {
  margin: 0 0 20px 0;
  color: #61dafb;
}

.App-header p {
  margin: 0;
  font-size: calc(8px + 2vmin);
}

@media (prefers-reduced-motion: no-preference) {
  .App-header {
    animation: App-header-pulse 2s ease-in-out infinite alternate;
  }
}

@keyframes App-header-pulse {
  from {
    background-color: #282c34;
  }
  to {
    background-color: #364049;
  }
}