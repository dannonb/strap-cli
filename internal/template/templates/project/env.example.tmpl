# {{.ProjectName}} Environment Configuration
# Copy this file to .env and update the values as needed

# =============================================================================
# SERVICE PORTS
# =============================================================================

{{if .Backend}}
# Backend Service
BACKEND_PORT={{.Backend.Port}}
{{if eq .Backend.Technology "fastapi"}}
# FastAPI specific settings
FASTAPI_ENV=development
FASTAPI_DEBUG=true
{{end}}
{{if eq .Backend.Technology "express"}}
# Express.js specific settings
NODE_ENV=development
EXPRESS_SESSION_SECRET=your-session-secret-here
{{end}}
{{if eq .Backend.Technology "gin"}}
# Gin specific settings
GIN_MODE=debug
GO_ENV=development
{{end}}
{{end}}

{{if .Frontend}}
# Frontend Service
FRONTEND_PORT={{.Frontend.Port}}
{{if eq .Frontend.Technology "react"}}
# React specific settings
REACT_APP_API_URL=http://localhost:{{if .Backend}}{{.Backend.Port}}{{else}}8000{{end}}
REACT_APP_ENV=development
{{end}}
{{if eq .Frontend.Technology "vue"}}
# Vue.js specific settings
VUE_APP_API_URL=http://localhost:{{if .Backend}}{{.Backend.Port}}{{else}}8000{{end}}
VUE_APP_ENV=development
{{end}}
{{if eq .Frontend.Technology "angular"}}
# Angular specific settings
NG_APP_API_URL=http://localhost:{{if .Backend}}{{.Backend.Port}}{{else}}8000{{end}}
NG_APP_ENV=development
{{end}}
{{end}}

{{if .Database}}
# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database Service
DATABASE_PORT={{.Database.Port}}
DATABASE_HOST=localhost

{{if eq .Database.Type "postgres"}}
# PostgreSQL Configuration
{{range $key, $value := .Database.Environment}}{{$key}}={{$value}}
{{end}}
POSTGRES_HOST=localhost
POSTGRES_PORT={{.Database.Port}}

# Connection URL for applications
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
{{end}}

{{if eq .Database.Type "mysql"}}
# MySQL Configuration
{{range $key, $value := .Database.Environment}}{{$key}}={{$value}}
{{end}}
MYSQL_HOST=localhost
MYSQL_PORT={{.Database.Port}}

# Connection URL for applications
DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}
{{end}}

{{if eq .Database.Type "mongo"}}
# MongoDB Configuration
{{range $key, $value := .Database.Environment}}{{$key}}={{$value}}
{{end}}
MONGO_HOST=localhost
MONGO_PORT={{.Database.Port}}

# Connection URL for applications
DATABASE_URL=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_INITDB_DATABASE}?authSource=admin
{{end}}

{{if eq .Database.Type "redis"}}
# Redis Configuration
{{range $key, $value := .Database.Environment}}{{$key}}={{$value}}
{{end}}
REDIS_HOST=localhost
REDIS_PORT={{.Database.Port}}

# Connection URL for applications
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0
{{end}}
{{end}}

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# JWT Settings (if using authentication)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h

# API Keys (add your external service API keys here)
# EXTERNAL_API_KEY=your-api-key-here

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# Enable/disable request logging
LOG_REQUESTS=true

# =============================================================================
# CORS SETTINGS
# =============================================================================

{{if and .Backend .Frontend}}
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:{{.Frontend.Port}}
{{else}}
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
{{end}}

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable development features
DEV_MODE=true

# Hot reload settings
HOT_RELOAD=true

# Debug settings
DEBUG=true

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Uncomment and modify these for production deployment

# BACKEND_PORT=80
# FRONTEND_PORT=80
# DEBUG=false
# DEV_MODE=false
# LOG_LEVEL=warn
# JWT_SECRET=your-production-jwt-secret
# DATABASE_PASSWORD=your-production-db-password