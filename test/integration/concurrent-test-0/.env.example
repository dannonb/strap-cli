# concurrent-test-0 Environment Configuration
# Copy this file to .env and update the values as needed

# =============================================================================
# SERVICE PORTS
# =============================================================================


# Backend Service
BACKEND_PORT=8000

# FastAPI specific settings
FASTAPI_ENV=development
FASTAPI_DEBUG=true









# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# JWT Settings (if using authentication)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h

# API Keys (add your external service API keys here)
# EXTERNAL_API_KEY=your-api-key-here

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# Enable/disable request logging
LOG_REQUESTS=true

# =============================================================================
# CORS SETTINGS
# =============================================================================


# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:4200


# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Enable development features
DEV_MODE=true

# Hot reload settings
HOT_RELOAD=true

# Debug settings
DEBUG=true

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Uncomment and modify these for production deployment

# BACKEND_PORT=80
# FRONTEND_PORT=80
# DEBUG=false
# DEV_MODE=false
# LOG_LEVEL=warn
# JWT_SECRET=your-production-jwt-secret
# DATABASE_PASSWORD=your-production-db-password